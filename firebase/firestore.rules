rules_version = '2';

// ── Reglas de Firestore para DermaCand ──
// Colecciones:
//   roles/{uid}     → { role: "admin" }  ó  { role: "editor", sections: ["inflam","onco", ...] }
//   cuentas/{uid}   → { email, nombre, apellido, estado: "pendiente|aprobada", aceptaTerminos, ... }
//   guias/{id}      → { section, subtype, name, path, updatedAt, uploadedBy }
//   config/github   → { token }   (PAT de GitHub para subir PDFs; se gestiona en consola)
//   reportes/{id}   → { texto, tipo, vista, build, ... }
//
// Lectura de guías: solo usuarios AUTORIZADOS (admin/editor, cuenta aprobada, o
//   usuario heredado sin ficha de cuenta). Ver función isApproved().
// Escritura de guías: admin (cualquier sección) o editor de ESA sección.
// La colección roles se gestiona desde la consola; el cliente no la escribe.
//
// Secciones de DermaCand (campo "section"): inflam, inf, folic, tric, ampoll,
//   onco, ped, urg, proc, patol, tto.

service cloud.firestore {
  match /databases/{database}/documents {

    function roleData() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data;
    }
    function hasRole() {
      return request.auth != null
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid));
    }
    function isAdmin() {
      return hasRole() && roleData().role == 'admin';
    }
    // ¿Puede el usuario actual editar guías de la sección indicada?
    function canEdit(section) {
      return isAdmin()
        || (hasRole()
            && roleData().role == 'editor'
            && (roleData().sections is list)
            && (section in roleData().sections));
    }

    // ── Aprobación de cuentas ──
    function accountData() {
      return get(/databases/$(database)/documents/cuentas/$(request.auth.uid)).data;
    }
    function hasAccount() {
      return request.auth != null
        && exists(/databases/$(database)/documents/cuentas/$(request.auth.uid));
    }
    // ¿Está autorizado el usuario a LEER el contenido?
    //  - admin/editor (rol asignado en consola), o
    //  - cuenta aprobada por el administrador, o
    //  - usuario HEREDADO sin ficha de cuenta (creado en consola antes del registro).
    // Una vez migrados todos a 'cuentas', puede endurecerse quitando "|| !hasAccount()".
    function isApproved() {
      return request.auth != null
        && ( hasRole()
          || !hasAccount()
          || accountData().estado == 'aprobada' );
    }

    match /guias/{id} {
      allow read:   if isApproved();
      allow create: if canEdit(request.resource.data.section);
      // Al actualizar, debe poder editar tanto la sección actual como la nueva
      // (impide "mover" una guía a una sección sobre la que no se tiene permiso).
      allow update: if canEdit(resource.data.section)
                    && canEdit(request.resource.data.section);
      allow delete: if canEdit(resource.data.section);
    }

    match /roles/{uid} {
      // Cada usuario lee su propio rol; el administrador puede listarlos todos (panel).
      allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin());
      // El principal gestiona cualquier rol. Un co-admin (admin no principal) puede gestionar
      // roles de NO-principales, pero nunca crear/editar otros administradores ni tocar al principal.
      allow write: if request.auth.uid == 'IXktZrlu5KSWMSyt6MO1Kt1fRZf1'
                   || ( isAdmin()
                        && uid != 'IXktZrlu5KSWMSyt6MO1Kt1fRZf1'
                        && (resource == null || resource.data.role != 'admin')
                        && (request.resource == null || request.resource.data.role != 'admin') );
    }

    // ── Ficha de cada usuario que ha iniciado sesión (incl. creados a mano) ──
    // Cada uno escribe SOLO su propio documento; el administrador puede leerlos todos.
    match /usuarios/{uid} {
      allow read:  if isAdmin();
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Cuentas de usuario y registro de aceptación de términos ──
    // Cada usuario crea su PROPIA ficha al registrarse (estado 'pendiente' y con la
    // aceptación de términos). Solo el admin puede leer todas, aprobar/rechazar o borrar.
    match /cuentas/{uid} {
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.estado == 'pendiente'
                    && request.resource.data.aceptaTerminos == true;
      allow read:   if request.auth != null && (request.auth.uid == uid || isAdmin());
      // El admin gestiona la ficha; ademas, el PROPIO usuario puede registrar SOLO su
      // aceptacion de terminos (sin auto-aprobarse ni tocar otros campos).
      allow update: if isAdmin()
                    || ( request.auth != null
                         && request.auth.uid == uid
                         && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['aceptaTerminos','versionTerminos','fechaAceptacion'])
                         && request.resource.data.aceptaTerminos == true );
      allow delete: if isAdmin();
    }

    match /textos/{id} {
      allow read:  if isApproved();
      allow write: if request.auth != null && request.auth.uid == 'IXktZrlu5KSWMSyt6MO1Kt1fRZf1';
    }

    // ── Listín telefónico: contactos personalizados añadidos desde la app ──
    // Los lee cualquier usuario autorizado; solo el administrador los crea/edita/borra.
    match /directorio/{id} {
      allow read:  if isApproved();
      allow write: if isAdmin();
    }

    // ── Créditos de colaboradores (editores) por tema ──
    // Cualquier usuario autorizado los LEE (para el Aviso Legal y los bloques de sección);
    // solo el administrador los escribe (al asignar/quitar perfil de editor).
    match /colaboradores/{uid} {
      allow read:  if isApproved();
      allow write: if isAdmin();
    }

    // ── Secciones del menú: renombrado, visibilidad, orden y secciones nuevas ──
    // Editable SOLO por administradores; efectiva para todos. Las lee cualquier usuario autorizado.
    match /secciones/{id} {
      allow read:  if isApproved();
      allow write: if isAdmin();
    }

    // ── Elementos del menú (herramientas): visibilidad y nombre, por tema ──
    // Editable SOLO por administradores; efectiva para todos.
    match /menuitems/{id} {
      allow read:  if isApproved();
      allow write: if isAdmin();
    }

    // ── Orden de las categorías del menú (doc 'orden') y diccionario del asistente de recetas ──
    // 'orden' (categorías) es solo-admin; 'recetas' (diccionario del asistente de recetas) lo pueden
    // editar también los editores del área 'asistentes'. Lo lee cualquier usuario autorizado.
    match /menuconfig/{id} {
      allow read:  if isApproved();
      allow write: if isAdmin() || (id == 'recetas' && canEdit('asistentes'));
    }

    // -- Algoritmos interactivos (arboles de decision) por seccion --
    // Lectura: cualquier usuario autorizado. Escritura: admin o editor de ESA seccion.
    // Al actualizar debe poder editar tanto la seccion actual como la nueva (impide mover
    // un algoritmo a una seccion sobre la que no se tiene permiso).
    match /algoritmos/{id} {
      allow read:   if isApproved();
      allow create: if canEdit(request.resource.data.seccion);
      allow update: if canEdit(resource.data.seccion)
                    && canEdit(request.resource.data.seccion);
      allow delete: if canEdit(resource.data.seccion);
    }

    // ── Calculadoras propias (puntuaciones/fórmulas), por sección ──
    // Las lee cualquier usuario autorizado; las crea/edita/mueve/borra quien puede editar ESA
    // sección (admin de cualquiera, o editor de la sección). Mover exige permiso en origen y destino.
    match /calculadoras/{id} {
      allow read:   if isApproved();
      allow create: if canEdit(request.resource.data.seccion);
      allow update: if canEdit(resource.data.seccion) && canEdit(request.resource.data.seccion);
      allow delete: if canEdit(resource.data.seccion);
    }

    // ── Páginas editadas (override del contenido de vistas existentes) ──
    // Lo lee cualquier usuario autorizado. Lo edita quien puede editar la sección a la que pertenece
    // la página (campo 'seccion'); si la página no tiene sección (vistas generales), solo un admin.
    // 'html' debe ser texto y de tamaño acotado (≤200 KB): evita almacenar cargas enormes o basura.
    // El cliente además sanea el HTML (DOMParser) e impone en el render que la sección del override
    // coincida con la real de la página y que la vista sea de contenido (no funcional).
    match /paginas/{id} {
      allow read:   if isApproved();
      allow create: if (isAdmin() || (request.resource.data.seccion is string && canEdit(request.resource.data.seccion)))
                    && request.resource.data.html is string
                    && request.resource.data.html.size() <= 200000;
      allow update: if (isAdmin() || (resource.data.seccion is string && canEdit(resource.data.seccion)
                                      && request.resource.data.seccion is string && canEdit(request.resource.data.seccion)))
                    && request.resource.data.html is string
                    && request.resource.data.html.size() <= 200000;
      allow delete: if isAdmin() || (resource.data.seccion is string && canEdit(resource.data.seccion));
    }

    match /config/{doc} {
      // Token de GitHub y similares: solo lo leen admin/editores (para subir PDF).
      // Nunca se escribe desde la app; se gestiona desde la consola.
      allow read:  if isAdmin() || (hasRole() && roleData().role == 'editor');
      allow write: if false;
    }

    // ── Reportes de errores / incidencias ──
    // Cualquier usuario autenticado puede CREAR un reporte (manual o captura automática de
    // un error de JS). Solo el administrador puede leerlos, marcarlos como resueltos o borrarlos.
    match /reportes/{id} {
      allow create: if request.auth != null
                    && request.resource.data.texto is string
                    && request.resource.data.texto.size() > 0
                    && request.resource.data.texto.size() <= 4000;
      allow read, update, delete: if isAdmin();
    }
  }
}
